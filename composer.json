{
	"name": "landrydjouonang-hue/multisite-fleet-manager",
	"description": "Central management console for WordPress Multisite networks: site inventory, health indicators, plugins and themes, users, reporting and an audited operation log.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"wordpress",
		"wordpress-plugin",
		"multisite",
		"network-admin",
		"site-management"
	],
	"authors": [
		{
			"name": "Djouonang Landry",
			"role": "Developer"
		}
	],
	"require": {
		"php": ">=8.0"
	},
	"require-dev": {
		"wp-coding-standards/wpcs": "^3.1",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"squizlabs/php_codesniffer": "^3.10",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"sort-packages": true
	},
	"scripts": {
		"lint": "phpcs",
		"lint:fix": "phpcbf",
		"lint:php": "find . -path ./vendor -prune -o -name '*.php' -print0 | xargs -0 -n1 php -l",
		"compat": "phpcs --standard=PHPCompatibilityWP --runtime-set testVersion 8.0- --extensions=php ."
	},
	"scripts-descriptions": {
		"lint": "Check the code against the WordPress coding standards.",
		"lint:fix": "Fix what the coding standards can fix automatically.",
		"lint:php": "Syntax-check every PHP file.",
		"compat": "Check PHP 8.0+ compatibility."
	},
	"support": {
		"issues": "https://github.com/landrydjouonang-hue/multisite-fleet-manager/issues",
		"source": "https://github.com/landrydjouonang-hue/multisite-fleet-manager"
	}
}
